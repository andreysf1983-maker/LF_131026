+        {
+            LF_LOG_ERROR("server.loading", "Spell %u: ImplicitTarget %u/%u >= TOTAL_SPELL_TARGETS (%u) - effect skipped.",
+                effect->SpellID, uint32(effect->ImplicitTarget[0]), uint32(effect->ImplicitTarget[1]), uint32(TOTAL_SPELL_TARGETS));
+            continue;
+        }
 
